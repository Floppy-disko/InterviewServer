// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  //moduleFormat = "cjs"
  //importFileExtension = "" // così import-a senza estensione, se no se usa .js non è compatibile con jest
}

datasource db {
  provider = "mysql"
}

model Utente {
  id                   Int          @id @default(autoincrement())
  email                String       @unique
  nome                 String
  cognome              String
  ruolo                String?
  intervisteRicevute   Intervista[] @relation()
  intervisteEffettuate Intervista[] @relation("IntervisteEffettuate")
  selezionatoInId      Int?
  selezionatoIn        Ricerca?     @relation(fields: [selezionatoInId], references: [id])
}

model Intervista {
  id             Int      @id @default(autoincrement())
  inizio         DateTime
  fine           DateTime
  stato          String   @default("programmata")
  candidatoId    Int
  candidato      Utente   @relation(fields: [candidatoId], references: [id])
  intervistatori Utente[] @relation("IntervisteEffettuate")
  ricerca        Ricerca  @relation(fields: [ricercaId], references: [id])
  ricercaId      Int
}

model Ricerca {
  id          Int          @id @default(autoincrement())
  descrizione String
  stato       String       @default("attiva")
  interviste  Intervista[]
  selezionati Utente[]
}
