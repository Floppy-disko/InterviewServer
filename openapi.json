            "example": 1,
            "minimum": 0
          },
          "intervistatori": {
            "description": "Array of interviewer user IDs (at least 1 required).\n- All interviewers must exist in the database.\n- Cannot include the candidate ID.\n- None of the interviewers can have overlapping interviews during [inizio, fine].",
